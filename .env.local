VITE_API_BASE_URL=http://localhost:3001

# Para produção no Vercel (exemplo):
# VITE_API_BASE_URL=https://seu-backend-nome.vercel.app

# AVWX API (Aviação/Clima)
VITE_AVWX_API_TOKEN=seu-token-avwx

# Modo
VITE_APP_ENV=development
