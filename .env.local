# Supabase Configuration
VITE_SUPABASE_URL=https://seu-supabase-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=seu-supabase-key-publico

# Backend Express API - ALTERE AQUI PARA SUA URL DO VERCEL
