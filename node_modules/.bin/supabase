#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules/supabase/dist/node_modules:/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules/supabase/node_modules:/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules:/root/app/code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules/supabase/dist/node_modules:/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules/supabase/node_modules:/root/app/code/node_modules/.pnpm/supabase@2.102.0/node_modules:/root/app/code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../supabase/dist/supabase.js" "$@"
else
  exec node  "$basedir/../supabase/dist/supabase.js" "$@"
fi
